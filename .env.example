# Everything is optional: with nothing set, PayPal runs simulated and the
# referee runs offline, so the whole flow works with zero keys.

# PayPal REST app (developer.paypal.com → Apps & Credentials → Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# The AI referee. Without it, an offline keyword referee is used.
ANTHROPIC_API_KEY=
# FAIRPAY_MODEL=claude-opus-5-5

# Prefill the freelancer email on the demo form (e.g. a sandbox personal account).
# NEXT_PUBLIC_DEMO_PAYEE=

# Public URL when deployed (used for PayPal's return link and MCP links).
# FAIRPAY_BASE_URL=https://fairpay.example.com

# Require "Authorization: Bearer <key>" on /api/mcp.
# FAIRPAY_AGENT_KEY=

# SQLite file (default data/fairpay.db).
# FAIRPAY_DB=data/fairpay.db
